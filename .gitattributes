* text=auto

# Files executed inside Ubuntu/WSL must retain Unix line endings.
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.xacro text eol=lf
*.sdf text eol=lf
*.srdf text eol=lf
*.obj text eol=lf
*.mtl text eol=lf
*.msg text eol=lf
*.action text eol=lf
# Decision records may be content-hash-bound by experiment contracts.
docs/decisions/*.md text eol=lf

# Binary project assets.
*.blend binary
*.png binary
*.jpg binary
*.jpeg binary
*.pt binary
*.zip binary

# Preserve this hash-bound mixed-platform experiment exactly as generated.
results/development/blender_v2_perception_handoff_pregrasp_v3/** binary
results/development/blender_v2_perception_pick_once_v3/** binary
results/development/blender_v2_grasp_pose_gripper_diagnostic_v4/** binary
