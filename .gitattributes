* text=auto

# Files executed inside Ubuntu/WSL must retain Unix line endings.
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.xacro text eol=lf
*.sdf text eol=lf
*.srdf text eol=lf
*.msg text eol=lf
*.action text eol=lf

# Binary project assets.
*.blend binary
*.png binary
*.jpg binary
*.jpeg binary
*.pt binary
*.zip binary
