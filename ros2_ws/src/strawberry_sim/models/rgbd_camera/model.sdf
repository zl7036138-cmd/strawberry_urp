<?xml version="1.0"?>
<sdf version="1.10">
  <model name="strawberry_rgbd_camera">
    <static>true</static>
    <link name="strawberry_camera_link">
      <visual name="housing_visual">
        <geometry><box><size>0.08 0.16 0.06</size></box></geometry>
        <material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <sensor name="rgbd" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.0471975512</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>5.0</far>
          </clip>
          <optical_frame_id>strawberry_camera_optical_frame</optical_frame_id>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/camera</topic>
        <gz_frame_id>strawberry_camera_optical_frame</gz_frame_id>
      </sensor>
    </link>
  </model>
</sdf>
