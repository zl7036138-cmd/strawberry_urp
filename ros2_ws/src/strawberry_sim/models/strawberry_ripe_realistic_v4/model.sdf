<?xml version="1.0"?>
<sdf version="1.10">
  <model name="strawberry_ripe_realistic_v4">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="fruit_link">
      <gravity>false</gravity>
      <velocity_decay><linear>0.5</linear><angular>0.5</angular></velocity_decay>
      <inertial>
        <mass>0.030</mass>
        <inertia><ixx>0.0000147</ixx><iyy>0.0000147</iyy><izz>0.0000147</izz></inertia>
      </inertial>
      <!-- Keep physics identical to A/B; only the visual asset changes. -->
      <collision name="fruit_collision">
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="fruit_crown_visual">
        <pose>0 0 0.007 0 0 0</pose>
        <geometry><sphere><radius>0.032</radius></sphere></geometry>
        <material>
          <ambient>0.45 0.04 0.03 1</ambient><diffuse>0.82 0.12 0.08 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/ripe_strawberry_skin_v2.png</albedo_map>
            <metalness>0.0</metalness><roughness>0.58</roughness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="fruit_tip_visual">
        <pose>0 0 -0.012 3.141592654 0 0</pose>
        <geometry><cone><radius>0.030</radius><length>0.040</length></cone></geometry>
        <material>
          <ambient>0.45 0.04 0.03 1</ambient><diffuse>0.82 0.12 0.08 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/ripe_strawberry_skin_v2.png</albedo_map>
            <metalness>0.0</metalness><roughness>0.58</roughness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="calyx_leaf_1"><pose>0.01000 0.00000 0.0345 0 0.22 0.000000</pose><geometry><box><size>0.030 0.009 0.002</size></box></geometry><material><ambient>0.01 0.22 0.01 1</ambient><diffuse>0.03 0.48 0.03 1</diffuse></material></visual>
      <visual name="calyx_leaf_2"><pose>0.00309 0.00951 0.0345 0 0.22 1.256637</pose><geometry><box><size>0.030 0.009 0.002</size></box></geometry><material><ambient>0.01 0.22 0.01 1</ambient><diffuse>0.03 0.48 0.03 1</diffuse></material></visual>
      <visual name="calyx_leaf_3"><pose>-0.00809 0.00588 0.0345 0 0.22 2.513274</pose><geometry><box><size>0.030 0.009 0.002</size></box></geometry><material><ambient>0.01 0.22 0.01 1</ambient><diffuse>0.03 0.48 0.03 1</diffuse></material></visual>
      <visual name="calyx_leaf_4"><pose>-0.00809 -0.00588 0.0345 0 0.22 3.769911</pose><geometry><box><size>0.030 0.009 0.002</size></box></geometry><material><ambient>0.01 0.22 0.01 1</ambient><diffuse>0.03 0.48 0.03 1</diffuse></material></visual>
      <visual name="calyx_leaf_5"><pose>0.00309 -0.00951 0.0345 0 0.22 5.026548</pose><geometry><box><size>0.030 0.009 0.002</size></box></geometry><material><ambient>0.01 0.22 0.01 1</ambient><diffuse>0.03 0.48 0.03 1</diffuse></material></visual>
      <visual name="stem_visual"><pose>0 0 0.041 0 0 0</pose><geometry><cylinder><radius>0.003</radius><length>0.014</length></cylinder></geometry><material><ambient>0.02 0.16 0.01 1</ambient><diffuse>0.05 0.36 0.02 1</diffuse></material></visual>
      <sensor name="fruit_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>fruit_collision</collision><topic>/strawberry/sim/fruit_contacts</topic></contact>
      </sensor>
    </link>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose><publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose><publish_sensor_pose>false</publish_sensor_pose>
      <publish_model_pose>true</publish_model_pose><use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>60</update_frequency>
    </plugin>
  </model>
</sdf>
