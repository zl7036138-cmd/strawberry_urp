<?xml version="1.0"?>
<sdf version="1.10">
  <model name="strawberry_unripe_tabletop_v1">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="fruit_link">
      <gravity>false</gravity>
      <velocity_decay><linear>0.5</linear><angular>0.5</angular></velocity_decay>
      <inertial>
        <mass>0.030</mass>
        <inertia><ixx>0.0000147</ixx><iyy>0.0000147</iyy><izz>0.0000147</izz></inertia>
      </inertial>
      <collision name="fruit_collision">
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="fruit_visual">
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <material>
          <ambient>0.12 0.38 0.02 1</ambient>
          <diffuse>0.25 0.72 0.04 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="calyx_visual">
        <pose>0 0 0.036 0 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.01 0.20 0.01 1</ambient><diffuse>0.02 0.45 0.02 1</diffuse></material>
      </visual>
      <sensor name="fruit_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>fruit_collision</collision><topic>/strawberry/sim/fruit_contacts</topic></contact>
      </sensor>
    </link>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>60</update_frequency>
    </plugin>
  </model>
</sdf>
