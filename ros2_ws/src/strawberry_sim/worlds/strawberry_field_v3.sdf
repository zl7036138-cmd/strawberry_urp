<?xml version="1.0"?>
<sdf version="1.10">
  <!-- Keep the runtime world name stable until field-v3 motion geometry is
       qualified. This lets the existing pose/contact bridges exercise the new
       visual scene without changing the accepted v2 default world. -->
  <world name="strawberry_orchard">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.52 0.50 0.45 1</ambient>
      <background>0.68 0.79 0.91 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="field_sun">
      <cast_shadows>true</cast_shadows>
      <pose>2 -4 8 0 0 0</pose>
      <diffuse>0.96 0.86 0.72 1</diffuse>
      <specular>0.20 0.18 0.15 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.25 -0.90</direction>
    </light>

    <light type="directional" name="field_fill">
      <cast_shadows>false</cast_shadows>
      <pose>-4 -2 6 0 0 0</pose>
      <diffuse>0.38 0.46 0.56 1</diffuse>
      <specular>0.08 0.08 0.10 1</specular>
      <direction>0.40 0.15 -0.90</direction>
    </light>

    <!-- Static visual field: 101 background plants share 24 reduced meshes.
         Physics sees only the ground and three conservative ridge boxes. -->
    <include>
      <uri>model://strawberry_field_v3</uri>
      <name>strawberry_field_environment</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Retained so fixed-camera mode remains valid. The field-v3 wrapper
         defaults to dual mode, where sim.launch.py removes this include. -->
    <include>
      <uri>model://rgbd_camera</uri>
      <name>strawberry_rgbd_camera</name>
      <pose>0 -1.10 1.05 0 0.35 1.5707963268</pose>
    </include>

    <!-- Move the bin off the planting ridge and away from the dual-camera mast. -->
    <include>
      <uri>model://collection_bin</uri>
      <name>collection_bin</name>
      <pose>-0.90 0.80 0 0 0 0</pose>
    </include>

    <!-- The Blender source bay omits two combined background meshes. The
         qualified v2 plant and rigid fruit models occupy that local workcell. -->
    <include>
      <uri>model://strawberry_plant_v2</uri>
      <name>strawberry_plant</name>
      <pose>0.55 0.0 0.30 0 0 0</pose>
    </include>

    <include>
      <uri>model://strawberry_ripe</uri>
      <name>strawberry_1</name>
      <pose>0.469064753 -0.053479813 0.376111838 -0.069813050 -0.087266445 0.733038306</pose>
    </include>
    <include>
      <uri>model://strawberry_unripe</uri>
      <name>strawberry_2</name>
      <pose>0.600333202 0.118588343 0.362157422 -0.104719654 0.087266445 -0.418878973</pose>
    </include>
    <include>
      <uri>model://strawberry_ripe</uri>
      <name>strawberry_3</name>
      <pose>0.628895651 0.068192676 0.370231110 0.087266490 -0.122173049 0.314159304</pose>
    </include>
  </world>
</sdf>
