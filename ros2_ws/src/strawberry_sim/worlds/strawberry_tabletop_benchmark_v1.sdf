<?xml version="1.0"?>
<sdf version="1.10">
  <world name="strawberry_orchard">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.80 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.90 0.90 0.90 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material><ambient>0.30 0.34 0.30 1</ambient><diffuse>0.46 0.52 0.46 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Work surface only; Panda is deliberately supplied by the later
         manipulation integration package and is not faked here. -->
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <collision name="table_collision">
          <pose>0.58 0 0.38 0 0 0</pose>
          <geometry><box><size>0.72 0.72 0.06</size></box></geometry>
        </collision>
        <visual name="table_visual">
          <pose>0.58 0 0.38 0 0 0</pose>
          <geometry><box><size>0.72 0.72 0.06</size></box></geometry>
          <material><ambient>0.24 0.13 0.06 1</ambient><diffuse>0.48 0.27 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://rgbd_camera</uri>
      <name>strawberry_rgbd_camera</name>
      <pose>0 -1.10 1.05 0 0.35 1.5707963268</pose>
    </include>

    <include>
      <uri>model://collection_bin</uri>
      <name>collection_bin</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://strawberry_ripe_tabletop_v1</uri>
      <name>strawberry_1</name>
      <pose>0.42 -0.12 0.52 0 0 0</pose>
    </include>
    <include>
      <uri>model://strawberry_unripe_tabletop_v1</uri>
      <name>strawberry_2</name>
      <pose>0.44 0.04 0.54 0 0 0</pose>
    </include>
    <include>
      <uri>model://strawberry_ripe_tabletop_v1</uri>
      <name>strawberry_3</name>
      <pose>0.38 0.17 0.50 0 0 0</pose>
    </include>
  </world>
</sdf>
